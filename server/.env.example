# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to Git.
 
# MongoDB connection string (from MongoDB Atlas — see setup guide)
MONGODB_URI=
 
# Server port
PORT=5000
 
# JWT secret — any long random string (see setup guide for how to generate one)
JWT_SECRET=
 
# Admin login credentials
ADMIN_USERNAME=
# This must be a BCRYPT HASH of your password, not the plain password
# (see setup guide for how to generate it)
ADMIN_PASSWORD_HASH=